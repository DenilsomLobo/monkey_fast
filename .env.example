# Copie para ".env.local" e preencha com os dados do app Web do seu projeto
# (Console do Firebase > Configurações do projeto > Seus apps > SDK do Firebase).
# Estes valores identificam o projeto e NÃO são segredos; a segurança vem das
# regras do Firestore e das validações nas Cloud Functions.
# Sem estas variáveis o jogo roda offline, com ranking local.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Região das Cloud Functions (padrão us-central1)
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Opcional (recomendado em produção): chave do site reCAPTCHA v3 para o App Check
VITE_FIREBASE_APPCHECK_SITE_KEY=

# true = usar os emuladores locais (firebase emulators:start)
VITE_USE_FIREBASE_EMULATORS=false
